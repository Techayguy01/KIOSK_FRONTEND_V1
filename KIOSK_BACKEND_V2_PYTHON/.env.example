# ─────────────────────────────────────────────
# Kiosk AI Backend V2 - Environment Configuration
# Copy to `.env` and fill in real values (do not commit `.env`)
# ─────────────────────────────────────────────

# LLM Providers (LiteLLM will try these in order)
GROQ_API_KEY=
OPENAI_API_KEY= # Optional, used as final fallback

# STT/TTS
YOUR_SARVAM_API_KEY=
DEEPGRAM_API_KEY= # Fallback STT
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=ritu
TTS_CACHE_VERSION=v1
TTS_CACHE_TTL_SECONDS=3600
TTS_CACHE_MAX_SIZE=200
TTS_PERSISTENT_CACHE_ENABLED=true
TTS_PERSISTENT_CACHE_DIR=.tts_cache

# Database (same as V1 - reusing existing Neon PostgreSQL)
DATABASE_URL=
DIRECT_URL=

# Server
PORT=8000
ENV=development
